<?xml version="1.0" encoding="utf-8"?>
<Defs>

  <!--
    Witcher low social: reduced social impact, modelling the famous Witcher emotional flatness.
    Vanilla Biotech has no SocialImpact gene; this is the only custom gene this mod ships.
  -->
  <GeneDef>
    <defName>Witcher_LowSocial</defName>
    <label>low social impact</label>
    <description>Carriers of this gene struggle to connect with others. Their words carry less weight in social interactions.</description>
    <displayCategory>Mood</displayCategory>
    <displayOrderInCategory>900</displayOrderInCategory>
    <biostatMet>1</biostatMet>
    <statFactors>
      <SocialImpact>0.65</SocialImpact>
    </statFactors>
  </GeneDef>

</Defs>
