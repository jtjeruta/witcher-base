    <descriptionShort>Survived the Trial of Grasses. Carries the first generation of witcher mutagens.</descriptionShort>
    <iconPath>UI/Icons/Genes/Witcher_CatEyes</iconPath>
    <inheritable>false</inheritable>
    <genes>
      <li>Immunity_Strong</li>
      <li>Robust</li>
      <li>WoundHealing_Fast</li>
      <li>DarkVision</li>
      <li>Sterile</li>
